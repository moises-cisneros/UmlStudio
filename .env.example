# Local development configuration. Copy this file to .env.local and fill only
# the values needed for the services you use. .env.local is intentionally ignored.

# Room AI endpoint configuration is intentionally not included here.
# The supported Room AI local-model deployment is configured separately per environment.

# Durable Room AI memory. The local Docker stack starts PostgreSQL alongside Redis.
# This password belongs only to the local Docker role created by the initialization script.
ROOM_MEMORY=postgres
MEMORY_DATABASE_URL=postgres://umlstudio_app:umlstudio_local_app@127.0.0.1:5432/umlstudio
