# UmlStudio — Seeder accounts template (NO SECRETS HERE)
#
# Copy to `.env.seed` (git-ignored, never commit) for local development:
#   cp .env.seed.example .env.seed
# Then replace every CHANGE_ME value with a strong password (min 12 chars,
# letters + numbers + symbol) and load it before boot/seed:
#   set -a; source .env.seed; set +a   (bash)
#   pnpm --filter @umlstudio/server seed:users
#
# PRODUCTION (Render dashboard > umlstudio-server > Environment):
# set UMLSTUDIO_SEED_USERS as a secret env var with the same JSON document.
# Never paste real passwords into this file, docs, or chat logs that get saved.
#
# Revoking the previously versioned demo accounts (one-time per environment):
#   pnpm --filter @umlstudio/server seed:revoke-legacy

UMLSTUDIO_SEED_USERS=[{"name":"CHANGE_ME_OWNER_NAME","email":"owner@umlstudio.app","password":"CHANGE_ME_OWNER_PASSWORD_MIN_12_CHARS"},{"name":"CHANGE_ME_LEAD_NAME","email":"lead@umlstudio.app","password":"CHANGE_ME_LEAD_PASSWORD_MIN_12_CHARS"},{"name":"CHANGE_ME_MODELER_NAME","email":"modeler.studio@umlstudio.app","password":"CHANGE_ME_MODELER_PASSWORD_MIN_12_CHARS"}]
