HOST=localhost
PORT=8000
WS_PORT=4444
CORS_ORIGIN=http://localhost:5173,capacitor://localhost,ionic://localhost
REDIS_URL=redis://localhost:6379

# Server-to-server only. Must match apps/ai-service/.env's AI_INTERNAL_TOKEN.
# Remote service URLs must use HTTPS; plain HTTP is limited to loopback for local development.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_INTERNAL_TOKEN=
# Summarize shared Room AI conversation after this many public messages.
# Number of public messages per shared summary update (1-10).
ROOM_AI_SUMMARY_EVERY=10

OWNER_SECRET=development-only-replace-in-prod

# Versioning limits
MAX_VERSIONS_PER_DIAGRAM=50
MAX_SNAPSHOT_BYTES=5242880
MAX_DESCRIPTION_LENGTH=240
MAX_NAME_LENGTH=80
