# Caddyfile: Reverse Proxy with Bearer Token Authentication for Ollama Contingency (Issue #33 / RNF-31)
# Listens on :8080 and proxies valid requests to Ollama (:11434).

:8080 {
    # Check Authorization header against the environment variable
    @authorized header Authorization "Bearer {$CONTINGENCY_BEARER_TOKEN}"

    handle @authorized {
        reverse_proxy localhost:11434 {
            header_up Host {upstream_hostport}
        }
    }

    # Deny unauthenticated requests with 401
    handle {
        respond "Unauthorized: valid Bearer token required for contingency Ollama tunnel." 401
    }
}
