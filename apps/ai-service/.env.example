# =====================================================================
# UmlStudio AI Service Configuration (:8001)
# Production Multi-Adapter Architecture for OMG UML 2.5
# =====================================================================

# 1. Google Gemini API (Recommended for structured tool calling & fast latency)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. OpenAI API (GPT-4o and Whisper STT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 3. Anthropic Claude API (Claude 3.7 Sonnet)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# 4. Groq API (High-speed Whisper Large v3 STT)
GROQ_API_KEY=

# 5. Local Gemma 2B (Ollama / vLLM local instance)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma:2b

# 6. Pipeline Provider Resolution
# 'auto' automatically selects and cascades: Gemini -> OpenAI -> Claude -> Local Gemma -> Mock
DEFAULT_PROVIDER=auto

# 7. Server Bindings
HOST=0.0.0.0
PORT=8001
