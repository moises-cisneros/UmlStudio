# =====================================================================
# UmlStudio AI Service Configuration (:8001)
# Production Multi-Adapter Architecture for OMG UML 2.5
# =====================================================================

# 1. Cloudflare Workers AI (Free Tier LLMs — Priority 1 in auto/cloud)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# 2. OpenRouter API (Free-tier models with auto-fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free,cohere/north-mini-code:free,qwen/qwen3.8-27b:free

# 3. Google Gemini API (Recommended for structured tool calling & fast latency)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 4. LM Studio Local (:1234 — Priority 4 in auto, Priority 1 in local)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen3-4b-toolcalling-codex
LMSTUDIO_VISION_MODEL=qwen3-vl-4b-instruct

# 5. Ollama Local (:11434 — Stronger default open model decided by benchmark)
OLLAMA_URL=http://localhost:11434/v1
# Default model: customized umlstudio-mentor (created via apps/ai-service/ollama/Modelfile)
OLLAMA_MODEL=umlstudio-mentor
# Direct base model (prior to running `ollama create umlstudio-mentor -f apps/ai-service/ollama/Modelfile`):
# OLLAMA_MODEL=qwen2.5:7b-instruct
# Fallback for low-spec / battery-saving mode: qwen2.5:3b
# OLLAMA_MODEL=qwen2.5:3b
# Optional authentication token or header for Ollama proxy / tunnel / Cloud Run
OLLAMA_API_KEY=
OLLAMA_AUTH_HEADER=

# 6. Whisper Speech-to-Text (faster-whisper local engine)
WHISPER_ENGINE=local
WHISPER_MODEL=base

# 7. Pipeline Provider Resolution
# Options:
# - 'auto': Cloudflare -> OpenRouter -> Gemini -> LM Studio -> Ollama (No mocks)
# - 'local': LM Studio -> Ollama (Prioritizes laptop local models)
# - 'cloud': Cloudflare -> OpenRouter -> Gemini (Remote models only)
DEFAULT_PROVIDER=auto

# 8. Server Bindings & Security
HOST=0.0.0.0
PORT=8001
# Allowed CORS origins for the webapp (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# 9. Internal room-response endpoint (share only with apps/server; never expose to the webapp)
AI_INTERNAL_TOKEN=
# Provider order for room responses (comma-separated, e.g. "ollama,gemini")
ROOM_PROVIDER_ORDER=ollama,gemini

# Room AI self-hosted OpenAI-compatible endpoint and model (both required when selected).
# Keep the endpoint server-side; private context never uses the default provider.
ROOM_AI_SELF_HOSTED_URL=
ROOM_AI_SELF_HOSTED_MODEL=
# Local tokenizer.json for the same model; model values must match exactly.
# The AI service rejects Room AI inference when the tokenizer is missing or mismatched.
ROOM_AI_TOKENIZER_FILE=
ROOM_AI_TOKENIZER_MODEL=
